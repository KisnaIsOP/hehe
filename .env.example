# Discord Bot Token (from Discord Developer Portal)
DISCORD_TOKEN=your_discord_bot_token_here

# OpenRouter API Key (from openrouter.ai)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Model to use (default: meta-llama/llama-3.2-3b-instruct:free)
OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct:free

# Bot personality mode (default: hinglish)
# Options: hinglish (casual Hinglish mix), english (friendly English), formal (professional)
BOT_PERSONALITY=hinglish

# Rate limit: max API calls per minute per guild (default: 10)
RATE_LIMIT_PER_MINUTE=10

# Context cache TTL in seconds (default: 300 = 5 minutes)
CACHE_TTL_SECONDS=300
